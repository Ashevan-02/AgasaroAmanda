# ----------------------------------------------------------------------------
# Apache Maven Wrapper startup batch script, v3.3.2
# ----------------------------------------------------------------------------

set -euf

# OS specific support.
cygwin=false
darwin=false
mingw=false
case "$(uname)" in
  CYGWIN*) cygwin=true ;;
  MINGW*) mingw=true ;;
  Darwin*) darwin=true ;;
  AIX*) aix=true ;;
  SunOS*) solaris=true ;;
  *) ;;
 esac


# Determine the current working directory
if [ -z "${BASE_DIR-}" ] ; then
  basedir=$(dirname "$0")
  BASE_DIR=$(cd "$basedir" && pwd)
fi

# set HOME if not set
if [ -z "${HOME-}" ] ; then
  export HOME=$(cd ~ && pwd)
fi

# For Cygwin, ensure paths are in UNIX format before anything is touched
if $cygwin ; then
  [ -n "$JAVA_HOME" ] && JAVA_HOME=$(cygpath --unix "$JAVA_HOME")
fi

# Locate Java binary
if [ -n "${JAVA_HOME-}" ] ; then
  JAVACMD="$JAVA_HOME/bin/java"
else
  JAVACMD="java"
fi

# Verify Java exists
if ! command -v "$JAVACMD" >/dev/null 2>&1 ; then
  echo "Error: Java is not installed or JAVA_HOME is not set." >&2
  exit 1
fi

# Wrapper settings
WRAPPER_DIR="$BASE_DIR/.mvn/wrapper"
WRAPPER_JAR="$WRAPPER_DIR/maven-wrapper.jar"
WRAPPER_PROPS="$WRAPPER_DIR/maven-wrapper.properties"

# Create wrapper dir if missing
mkdir -p "$WRAPPER_DIR"

# Load properties
if [ -f "$WRAPPER_PROPS" ]; then
  . "$WRAPPER_PROPS" 2>/dev/null || true
fi

# Default URLs if not set in properties file
: "${distributionUrl:=https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/3.9.9/apache-maven-3.9.9-bin.zip}"
: "${wrapperUrl:=https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.3.2/maven-wrapper-3.3.2.jar}"

# Download wrapper jar if missing
if [ ! -f "$WRAPPER_JAR" ]; then
  echo "Downloading Maven Wrapper JAR..." >&2
  if command -v curl >/dev/null 2>&1; then
    curl -sSfL "$wrapperUrl" -o "$WRAPPER_JAR"
  elif command -v wget >/dev/null 2>&1; then
    wget -q "$wrapperUrl" -O "$WRAPPER_JAR"
  else
    echo "Error: curl or wget is required to download the Maven Wrapper." >&2
    exit 1
  fi
fi

# Prepare Maven distribution path
MAVEN_USER_HOME="${MAVEN_USER_HOME:-$HOME/.m2}"
MAVEN_WRAPPER_DIR="$MAVEN_USER_HOME/wrapper/dists"
MAVEN_DIST_NAME=$(echo "$distributionUrl" | sed -e 's#\(.*/\)\([^/]*\)\(-bin.zip\)$#\2#')
MAVEN_DIST_DIR="$MAVEN_WRAPPER_DIR/apache-maven-$MAVEN_DIST_NAME"
MAVEN_DIST_BIN="$MAVEN_DIST_DIR/bin/mvn"

# Download and unpack Maven if needed
if [ ! -x "$MAVEN_DIST_BIN" ]; then
  echo "Downloading Apache Maven distribution..." >&2
  TMP_ZIP="$WRAPPER_DIR/maven-dist.zip"
  if command -v curl >/dev/null 2>&1; then
    curl -sSfL "$distributionUrl" -o "$TMP_ZIP"
  else
    wget -q "$distributionUrl" -O "$TMP_ZIP"
  fi
  mkdir -p "$MAVEN_DIST_DIR"
  # Extract Maven distribution; force overwrite to avoid interactive prompts
  unzip -o -q "$TMP_ZIP" -d "$MAVEN_WRAPPER_DIR"
  rm -f "$TMP_ZIP"
fi

# Build classpath and run wrapper
WRAPPER_LAUNCHER=org.apache.maven.wrapper.MavenWrapperMain
exec "$JAVACMD" \
  -cp "$WRAPPER_JAR" \
  "${WRAPPER_LAUNCHER}" \
  -Dmaven.multiModuleProjectDirectory="$BASE_DIR" \
  "$@"
